# Use the staging environment for this preview demo.
NEON_PROFILE=staging
NEON_API_HOST=https://console-stage.neon.build/api/v2
NEON_OAUTH_HOST=https://oauth2-stage.neon.build
NEON_CLI_PATH=/path/to/built/neon-pkgs/packages/cli/dist/cli.js
NEON_ORG_ID=your_staging_org
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@host/neondb?sslmode=verify-full
NEON_REALTIME_SECRET=
NEON_REALTIME_URL=wss://your-branch-neonrealtimesocket.compute.example/
NEON_AUTH_BASE_URL=https://your-branch.neonauth.example/neondb/auth
NEON_AUTH_JWKS_URL=https://your-branch.neonauth.example/neondb/auth/.well-known/jwks.json
APP_ORIGIN=http://localhost:5180
API_BASE_URL=http://localhost:3080
OAUTH_SECRET=generate-at-least-32-random-characters
# Empty uses Vite's local API proxy. Production builds use the same-origin API.
PUBLIC_API_BASE_URL=
# Tests are opt-in against an isolated Postgres database.
TEST_DATABASE_URL=
